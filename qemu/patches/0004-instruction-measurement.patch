+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef EXEC_HIOS_PROFILE_H
+#define EXEC_HIOS_PROFILE_H
+
+/* Diagnostic-only, per-vCPU accounting.  Generated A64 TBs charge their static
+ * length at entry (including direct chains). restore_state subtracts the unused
+ * tail. A longjmp without restore records the whole last credit as uncertain:
+ * [credited - uncertain, credited] is the stated instruction-count interval.
+ * This is not a PMU retired-instruction counter and includes firmware/kernel.
+ * Read these fields only after all vCPUs have stopped.  No live global counters.
+ */
+typedef struct HiosProfileBucket {
+    uint64_t instructions;
+    uint64_t uncertain;
+    uint64_t address;
+} HiosProfileBucket;
+
+typedef struct HiosProfileState {
+    uint64_t instructions[2]; /* EL0, then EL1+ (not address-based guessing) */
+    uint64_t blocks[2];
+    uintptr_t active_tb;
+    uint64_t active_credit;
+    uint64_t active_class;
+    HiosProfileBucket *active_bucket;
+    uint64_t uncertain[2];
+    uint64_t corrected_tail;
+    uint64_t corrections;
+    uint64_t unbounded_exits;
+    uint64_t translations;
+    int mode; /* 1 = inline totals, 2 = totals + slower full-VA bucket helper */
+    GHashTable *buckets;
+} HiosProfileState;
+
+static inline void hios_profile_restore(CPUState *cpu, const void *tb,
+                                        unsigned insns_left)
+{
+    HiosProfileState *state = cpu->hios_profile;
+    if (!state || !state->active_credit || state->active_tb != (uintptr_t)tb) {
+        return;
+    }
+    assert(insns_left <= state->active_credit);
+    state->instructions[state->active_class] -= insns_left;
+    if (state->active_bucket) {
+        state->active_bucket->instructions -= insns_left;
+    }
+    state->corrected_tail += insns_left;
+    state->corrections++;
+    state->active_credit = 0;
+}
+
+static inline void hios_profile_longjmp(CPUState *cpu)
+{
+    HiosProfileState *state = cpu->hios_profile;
+    if (!state || !state->active_credit) {
+        return;
+    }
+    state->uncertain[state->active_class] += state->active_credit;
+    if (state->active_bucket) {
+        state->active_bucket->uncertain += state->active_credit;
+    }
+    state->unbounded_exits++;
+    state->active_credit = 0;
+}
+
+#endif
