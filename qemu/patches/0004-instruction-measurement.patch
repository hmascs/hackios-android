+static void hios_profile_dump(GString *buf)
+{
+    CPUState *cpu;
+
+    if (runstate_is_running()) {
+        g_string_append(buf, "HIOS_PROFILE_UNAVAILABLE pause-vcpus-first\n");
+        return;
+    }
+    CPU_FOREACH(cpu) {
+        HiosProfileState *state = cpu->hios_profile;
+        if (!state) {
+            continue;
+        }
+        g_string_append_printf(buf,
+            "HIOS_PROFILE {\"cpu\":%d,\"mode\":%d,"
+            "\"user_instructions\":%"PRIu64",\"kernel_instructions\":%"PRIu64","
+            "\"user_blocks\":%"PRIu64",\"kernel_blocks\":%"PRIu64","
+            "\"user_uncertain\":%"PRIu64",\"kernel_uncertain\":%"PRIu64","
+            "\"corrected_tail\":%"PRIu64",\"corrections\":%"PRIu64","
+            "\"unbounded_exits\":%"PRIu64",\"translations\":%"PRIu64"}\n",
+            cpu->cpu_index, state->mode, state->instructions[0],
+            state->instructions[1], state->blocks[0], state->blocks[1],
+            state->uncertain[0], state->uncertain[1], state->corrected_tail,
+            state->corrections, state->unbounded_exits, state->translations);
+        if (state->buckets) {
+            GHashTableIter iterator;
+            gpointer key, value;
+            g_hash_table_iter_init(&iterator, state->buckets);
+            while (g_hash_table_iter_next(&iterator, &key, &value)) {
+                HiosProfileBucket *bucket = value;
+                g_string_append_printf(buf,
+                    "HIOS_BUCKET {\"cpu\":%d,\"address\":\"0x%016"PRIx64"\","
+                    "\"instructions\":%"PRIu64",\"uncertain\":%"PRIu64"}\n",
+                    cpu->cpu_index, bucket->address, bucket->instructions,
+                    bucket->uncertain);
+            }
+        }
+    }
+}
+
 void tcg_get_stats(AccelState *accel, GString *buf)
 {
     dump_accel_info(accel, buf);
     dump_exec_info(buf);
     dump_drift_info(buf);
+    hios_profile_dump(buf);
 }
 
