+    dc->hios_count_add = tcg_last_op();
+    tcg_gen_st_i64(value, state, count_offset);
+    tcg_gen_ld_i64(value, state, block_offset);
+    tcg_gen_addi_i64(value, value, 1);
+    tcg_gen_st_i64(value, state, block_offset);
+    tcg_gen_st_ptr(tcg_constant_ptr(db->tb), state,
+                   offsetof(HiosProfileState, active_tb));
+    tcg_gen_st_i64(tcg_constant_i64(1), state,
+                   offsetof(HiosProfileState, active_credit));
+    dc->hios_credit_store = tcg_last_op();
+    tcg_gen_st_i64(tcg_constant_i64(cls), state,
+                   offsetof(HiosProfileState, active_class));
 }
 
