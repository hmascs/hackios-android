+/* Mode 2 only: full runtime VA, including CF_PCREL aliases.  No modulo key,
+ * no cross-vCPU mutation and no sampling multiplier.  Kept off in mode 1. */
+void *HELPER(hios_profile_bucket)(CPUARMState *env, uint64_t pc)
+{
+    HiosProfileState *state = env_cpu(env)->hios_profile;
+    uint64_t key = pc & ~UINT64_C(0x3fffff);
+    HiosProfileBucket *bucket = g_hash_table_lookup(state->buckets, &key);
+    if (!bucket) {
+        uint64_t *owned_key = g_new(uint64_t, 1);
+        *owned_key = key;
+        bucket = g_new0(HiosProfileBucket, 1);
+        bucket->address = key;
+        g_hash_table_insert(state->buckets, owned_key, bucket);
+    }
+    state->active_bucket = bucket;
+    return bucket;
+}
 
