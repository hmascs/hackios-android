--- a/accel/tcg/translator.c
+++ b/accel/tcg/translator.c
@@ -13,6 +13,8 @@
 #include "qemu/error-report.h"
 #include "accel/tcg/cpu-ldst-common.h"
 #include "accel/tcg/cpu-mmu-index.h"
+#include "exec/icount.h"
+#include "exec/replay-core.h"
 #include "exec/target_page.h"
 #include "exec/translator.h"
 #include "tcg/tcg-op-common.h"
@@ -31,7 +33,19 @@
     /*
      * Ensure that this instruction will be the last in the TB.
      * The target may override this to something more forceful.
+     *
+     * hios: ending the TB here exists only so that an icount or replay clock
+     * stays in step with the instruction count.  ARM flags the generic-timer
+     * counters ARM_CP_IO, so with neither enabled this cut every guest
+     * CNTVCT_EL0 read -- which XNU performs constantly -- into a TB exit plus
+     * a main-loop round trip.  Measured on this guest, ~50% of all guest CPU
+     * time sat in the two counter-reading functions.  Without an icount or
+     * replay clock there is nothing to synchronise: let the access be an
+     * ordinary helper call inside the block.
      */
+    if (!icount_enabled() && replay_mode == REPLAY_MODE_NONE) {
+        return false;
+    }
     if (db->is_jmp == DISAS_NEXT) {
         db->is_jmp = DISAS_TOO_MANY;
     }
