<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon background: solid black. The foreground (phone outline + iOS wordmark +
     three loading dots) is drawn for black-on-black contrast, so the launcher tile keeps the
     Apple-dark look instead of the previous blue->indigo ramp. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#000000" />
</shape>
